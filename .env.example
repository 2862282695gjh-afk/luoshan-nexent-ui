# Server-side only. Do not prefix secrets with VITE_.
NEXENT_BASE_URL=http://127.0.0.1:30013
NEXENT_API_KEY=
NEXENT_AGENT_NAME=general-assistant
PORT=5180
HOST=127.0.0.1
# Optional trusted portal origins allowed to frame /embed/; separate multiple origins with spaces or commas.
# The application's own origin is always allowed. Example: https://portal.example.com
EMBED_ALLOWED_ORIGINS=

# Optional: Nexent main API for scheduled-task proposals (separate from northbound).
# Use the runtime service root, or a gateway URL ending in /api.
NEXENT_MAIN_API_URL=
NEXENT_USER_TOKEN=
NEXENT_AUTOMATION_AGENT_ID=
# Defaults to jwt. Use speed only for a verified Nexent speed-mode deployment.
NEXENT_AUTOMATION_AUTH_MODE=jwt
# Optional config-service root when main API points directly to the runtime service.
# Leave blank when main API is a gateway exposing /agent/published_list.
NEXENT_AGENT_API_URL=
